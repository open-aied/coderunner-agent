     }
 
+    if ($oldversion < 2026031500) {
+        $dbman = $DB->get_manager();
+        $table = new xmldb_table('question_coderunner_options');
+        $field = new xmldb_field('agentphasefree', XMLDB_TYPE_INTEGER, '1', null, XMLDB_NOTNULL, null, '0', 'prototypeextra');
+        if (!$dbman->field_exists($table, $field)) {
+            $dbman->add_field($table, $field);
+        }
+        upgrade_plugin_savepoint(true, 2026031500, 'qtype', 'coderunner');
+    }
+
     require_once(__DIR__ . '/upgradelib.php');
     update_question_types();
 
