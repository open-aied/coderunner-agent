# ──────────────────────────────────────────────────────────────────────────────
# CodeRunner Agent — environment template
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# The defaults below work out of the box for LOCAL development
# (cp .env.example .env, set OPENAI_API_KEY, then ./setup.sh).
#
# For a SERVER / PRODUCTION deployment, uncomment and edit the values in the
# "PRODUCTION" block at the bottom and run ./setup.sh --prod.
# ──────────────────────────────────────────────────────────────────────────────

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Replace sk-... with your own OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_REASONING_EFFORT=none
OPENAI_MAX_OUTPUT_TOKENS=600

# ── SQLite ────────────────────────────────────────────────────────────────────
SQLITE_PATH=data/interactions.db

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=moodle_root
MYSQL_PASSWORD=moodle

# ── Moodle admin account ──────────────────────────────────────────────────────
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin1234!
MOODLE_ADMIN_EMAIL=admin@example.com

# ── Timezone (IANA name; controls Moodle display and scheduled tasks) ─────────
MOODLE_TIMEZONE=Asia/Tokyo

# ── Jobe base image (optional; default trampgeek/jobeinabox:latest) ───────────
# Pin a digest or point at a team image if you need a fixed / older OS base.
# JOBE_BASE=trampgeek/jobeinabox@sha256:...

# ── Local deployment defaults ─────────────────────────────────────────────────
MOODLE_WWWROOT=http://localhost
MOODLE_SSL_PROXY=false
# Student panel calls Agent API from the browser; * allows localhost:80 → :8001.
CORS_ORIGINS=*
# MOODLE_PORT=80
# AGENT_PORT=8001
# CODERUNNER_AGENT_URL=http://host.docker.internal:8001

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION (uncomment + edit for a server deployment, then run ./setup.sh --prod)
# ══════════════════════════════════════════════════════════════════════════════
# Replace your-domain.example.com with your real domain and replace every
# CHANGE_ME below with a strong, unique secret.
#
# CORS_ORIGINS=https://your-domain.example.com
# MOODLE_WWWROOT=https://your-domain.example.com/coderunner-agent
# CODERUNNER_AGENT_URL=https://your-domain.example.com/coderunner-agent/api
# MOODLE_SSL_PROXY=true
#
# MYSQL_ROOT_PASSWORD=CHANGE_ME
# MYSQL_PASSWORD=CHANGE_ME
# MOODLE_ADMIN_PASSWORD=CHANGE_ME
#
# Suffix appended to Moodle's session cookie name (cookie becomes MoodleSession<suffix>).
# Prevents collisions when multiple PHP apps share the same hostname behind a proxy.
# MOODLE_SESSION_COOKIE_SUFFIX=cra
#
# Host ports (must not conflict with other services on the host).
# MOODLE_PORT=8003
# AGENT_PORT=8083
